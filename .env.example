DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_discord_client_secret_here
BOT_OWNER_ID=your_discord_id_here

SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres.your_project_id:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your_project_id:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

ENCRYPTION_SECRET=your_32_byte_aes_256_encryption_secret_key_here

DASHBOARD_PORT=3000
DASHBOARD_URL=https://your-domain.com

UPDATE_INTERVAL=60000
MINECRAFT_CONFIG_CACHE_MS=300000
GUILD_SETTINGS_CACHE_MS=15000
MC_BANNER_ASSET_DIR=MCServerBanner/node-assets
MINECRAFT_ASSET_VERSION=1.21.10
MC_BANNER_CACHE_SECONDS=300
MC_BANNER_MAX_CACHE_ENTRIES=300
MC_BANNER_CONNECT_TIMEOUT_MS=4000
MC_BANNER_READ_TIMEOUT_MS=5000
MC_BANNER_PROTOCOL=-1
MC_BANNER_MAX_CONCURRENT_RENDERS=1
MC_BANNER_ALLOW_PRIVATE_HOSTS=false
MC_BANNER_STRIP_PRIVATE_GLYPHS=true

DEBUG_WEBHOOKS=0
