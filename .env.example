# ═══════════════════════════════════════
# Discord Bot Credentials
# ═══════════════════════════════════════
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_discord_client_secret_here
BOT_OWNER_ID=your_discord_id_here

# ═══════════════════════════════════════
# Supabase Configuration
# ═══════════════════════════════════════
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
# Runtime SQL through transaction pooler (IPv4)
DATABASE_URL=postgresql://postgres.your_project_id:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations through session pooler (preferred)
DIRECT_URL=postgresql://postgres.your_project_id:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres

# ═══════════════════════════════════════
# Security & Encryption
# ═══════════════════════════════════════
ENCRYPTION_SECRET=your_32_byte_aes_256_encryption_secret_key_here

# ═══════════════════════════════════════
# Dashboard Settings
# ═══════════════════════════════════════
DASHBOARD_PORT=3000
DASHBOARD_URL=https://your-domain.com
# DASHBOARD_PASSWORD không dùng — dashboard xác thực bằng Discord OAuth2

# ═══════════════════════════════════════
# Minecraft status and banner renderer
# Run `npm run assets:prepare` before first production start.
# Private/LAN targets stay blocked by default to prevent SSRF/port scanning.
# ═══════════════════════════════════════
UPDATE_INTERVAL=60000
MINECRAFT_CONFIG_CACHE_MS=300000
GUILD_SETTINGS_CACHE_MS=15000
MC_BANNER_ASSET_DIR=MCServerBanner/node-assets
MINECRAFT_ASSET_VERSION=1.21.10
MC_BANNER_CACHE_SECONDS=300
MC_BANNER_MAX_CACHE_ENTRIES=300
MC_BANNER_CONNECT_TIMEOUT_MS=4000
MC_BANNER_READ_TIMEOUT_MS=5000
MC_BANNER_PROTOCOL=-1
MC_BANNER_MAX_CONCURRENT_RENDERS=1
MC_BANNER_ALLOW_PRIVATE_HOSTS=false
MC_BANNER_STRIP_PRIVATE_GLYPHS=true

# ═══════════════════════════════════════
# top.gg API Token (tuỳ chọn)
# Dùng để tự động whitelist bot đã có trên top.gg khi vào server.
# API top.gg BẮT BUỘC có token — không có token thì bước kiểm tra này
# được bỏ qua hoàn toàn, và bot chưa verify sẽ bị Anti-Bot xử lý.
# Lấy tại: https://top.gg/api/docs#mybots
# ═══════════════════════════════════════
TOPGG_TOKEN=

# ═══════════════════════════════════════
# Debug webhook (tuỳ chọn) — đặt =1 để bật log chi tiết webhook Card2K.
# Mặc định tắt: log đầy đủ sẽ in ra mã thẻ và số seri.
# ═══════════════════════════════════════
DEBUG_WEBHOOKS=0
